PORT=5001
# Leave MONGODB_URI empty to run on in-memory sample data (demo mode).
# Set it to switch to MongoDB, e.g. mongodb://127.0.0.1:27017/ecomm_demo
MONGODB_URI=
# Comma-separated frontend origins allowed by CORS; `*` is a wildcard (e.g. https://void-ecomm-frontend-*.vercel.app).
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001
